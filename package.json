{
  "name": "leetsrs",
  "description": "A spaced repetition extension for LeetCode problems",
  "private": true,
  "version": "1.6.5",
  "license": "MIT",
  "author": "Matt Drake",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:persistent": "wxt",
    "dev:reset": "node -e \"require('node:fs').rmSync('.wxt/chrome-data', { recursive: true, force: true })\"",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "precompile": "node -e \"require('node:fs').existsSync('.wxt/tsconfig.json') || require('node:child_process').execSync('wxt prepare', { stdio: 'inherit' })\"",
    "compile": "tsc --noEmit",
    "format": "biome format --write .",
    "format:markdown": "prettier --write \"**/*.md\"",
    "format:markdown:check": "prettier --check \"**/*.md\"",
    "pretest": "node -e \"require('node:fs').existsSync('.wxt/tsconfig.json') || require('node:child_process').execSync('wxt prepare', { stdio: 'inherit' })\"",
    "test": "vitest --run",
    "check": "biome check --error-on-warnings . && npm run format:markdown:check && npm run compile && npm test",
    "postinstall": "wxt prepare",
    "backend:build": "wrangler deploy --dry-run --config backend/wrangler.jsonc",
    "backend:deploy": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.105.0",
    "@webext-core/proxy-service": "^3.0.2",
    "react": "^19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-stately": "3.51.0",
    "tailwindcss": "^4.1.11",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.1.3",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wrangler": "^4.153.0",
    "wxt": "^0.21.5"
  }
}
