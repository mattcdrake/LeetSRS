{
  "name": "leetsrs",
  "description": "A spaced repetition extension for LeetCode problems",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "author": "Matt Drake",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:verbose": "vitest --run --reporter=verbose",
    "check": "biome check --error-on-warnings . && npm run compile && npm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.102.8",
    "@webext-core/messaging": "^4.0.0",
    "chart.js": "^4.5.0",
    "octokit": "^5.0.5",
    "react": "^19.1.0",
    "react-aria-components": "^1.11.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.11",
    "ts-fsrs": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/ui": "^4.1.10",
    "@wxt-dev/module-react": "^1.1.3",
    "happy-dom": "^20.3.4",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
