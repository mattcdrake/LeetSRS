{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!.wxt",
      "!.output",
      "!dist",
      "!node_modules",
      "!**/.venv",
      "!coverage",
      "!experiments",
      "!automation",
      "!public",
      "!stats.html",
      "!stats-*.json",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!**/*.min.js",
      "!**/*.min.css"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["shared/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/background/**",
                      "@/popup/**",
                      "@/content/**",
                      "@/entrypoints/**",
                      "**/background/**",
                      "**/popup/**",
                      "**/content/**",
                      "**/entrypoints/**",
                      "@/shared/i18n",
                      "@/shared/i18n/**",
                      "@/shared/ui/**",
                      "**/i18n/**",
                      "**/ui/**"
                    ],
                    "message": "Shared modules must remain independent of runtime owners and UI."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["shared/ui/**/*.ts", "shared/ui/**/*.tsx", "shared/i18n/**/*.ts", "!shared/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/background/**",
                      "@/popup/**",
                      "@/content/**",
                      "@/entrypoints/**",
                      "**/background/**",
                      "**/popup/**",
                      "**/content/**",
                      "**/entrypoints/**"
                    ],
                    "message": "Shared presentation modules must remain independent of runtime owners."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["popup/**/*.ts", "popup/**/*.tsx", "!popup/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/background/**",
                      "**/background/**",
                      "@/content/**",
                      "**/content/**",
                      "@/entrypoints/**",
                      "**/entrypoints/**"
                    ],
                    "message": "Import shared contracts instead of another runtime owner."
                  },
                  {
                    "group": ["@/shared/storage", "**/shared/storage"],
                    "importNamePattern": "(replaceLearningDocument|writeGistConnection|removeGistConnection|writeSyncStatus|removeSyncStatus)",
                    "message": "Use the background service for persisted writes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["content/**/*.ts", "content/**/*.tsx", "!content/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/background/**",
                      "**/background/**",
                      "@/popup/**",
                      "**/popup/**",
                      "@/entrypoints/**",
                      "**/entrypoints/**"
                    ],
                    "message": "Import shared contracts instead of another runtime owner."
                  },
                  {
                    "group": ["@/shared/storage", "**/shared/storage"],
                    "importNamePattern": "(replaceLearningDocument|writeGistConnection|removeGistConnection|writeSyncStatus|removeSyncStatus)",
                    "message": "Use the background service for persisted writes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["background/**/*.ts", "background/**/*.tsx", "!background/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/popup/**",
                      "**/popup/**",
                      "@/content/**",
                      "**/content/**",
                      "@/entrypoints/**",
                      "**/entrypoints/**"
                    ],
                    "message": "Import shared contracts instead of another runtime owner."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
