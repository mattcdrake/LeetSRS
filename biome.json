{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!.wxt",
      "!**/.wrangler",
      "!.output",
      "!dist",
      "!node_modules",
      "!**/.venv",
      "!coverage",
      "!experiments",
      "!automation",
      "!public",
      "!stats.html",
      "!stats-*.json",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!**/*.min.js",
      "!**/*.min.css"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
